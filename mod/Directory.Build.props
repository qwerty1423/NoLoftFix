<Project>
  <PropertyGroup>
    <NuclearOptionDir Condition="'$(NuclearOptionDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Nuclear Option</NuclearOptionDir>

    <ManagedDir Condition="'$(ManagedDir)' == '' and Exists('$(NuclearOptionDir)/NuclearOption_Data/Managed')">$(NuclearOptionDir)/NuclearOption_Data/Managed</ManagedDir>
    <ManagedDir Condition="'$(ManagedDir)' == '' and Exists('$(NuclearOptionDir)/NuclearOptionServer_Data/Managed')">$(NuclearOptionDir)/NuclearOptionServer_Data/Managed</ManagedDir>
  </PropertyGroup>

  <Target Name="ValidateManagedDir" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedDir)/Assembly-CSharp.dll')"
           Text="ManagedDir is invalid or missing: $(ManagedDir). Pass -p:ManagedDir=/path/to/NuclearOption_Data/Managed" />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
      <Publicize>true</Publicize>
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
    <Reference Include="Mirage">
      <HintPath>$(ManagedDir)/Mirage.dll</HintPath>
      <Private>false</Private>
      <Publicize>true</Publicize>
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
  </ItemGroup>
</Project>
